# ---- Required ---------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret
# production refuses to start with a default SECRET_KEY. Use "development" only on your laptop.
FLASK_ENV=production

# The AWS account that CloudShield itself runs in (customers trust this account in their IAM role).
CLOUDSHIELD_AWS_ACCOUNT_ID=111122223333

# ---- Database ---------------------------------------------------------------
# SQLite (cheapest; stored in the Docker volume / ./instance):
DATABASE_URL=sqlite:///cloudshield.db
# MySQL (use together with docker-compose.mysql.yml):
# DATABASE_URL=mysql+pymysql://cloudshield:PASSWORD@db:3306/cloudshield?charset=utf8mb4
# MYSQL_PASSWORD=change-me
# MYSQL_ROOT_PASSWORD=change-me-too

# ---- AWS identity of the CloudShield server ---------------------------------
# On EC2 attach an instance role that allows sts:AssumeRole (see infrastructure/iam/) and leave these empty.
# On any other host use an IAM user that can ONLY call sts:AssumeRole:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
CLOUDSHIELD_BACKUP_ROLE_NAME=CloudShieldDRBackupRole

# ---- Behaviour / cost knobs (defaults are the cheap, safe choice) -----------
# Set to true once you serve the site over HTTPS:
SESSION_COOKIE_SECURE=false
BACKUP_STORAGE_CLASS=INTELLIGENT_TIERING
MAX_BACKUP_SIZE_MB=512
BACKGROUND_SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
